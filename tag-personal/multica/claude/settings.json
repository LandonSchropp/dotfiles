{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Read(.env)",
      "Read(**/.env*)",
      "Read(**/.secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(~/Notes/Resources/Journal/**)"
    ],
    "additionalDirectories": ["~/Notes", "~/Development", "~/.claude"]
  },
  "model": "opus[1m]",
  "voiceEnabled": false
}
