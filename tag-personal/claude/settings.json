{
  "skillListingBudgetFraction": 0.2,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Running interactive-review/scripts/record-approval.sh after a \"Hunk review decision ... review-approved\" Stop hook notification. The hunk-verdict hook reports review-approved only when the user presses the approve key in Hunk, so that notification is the user's own approval."
    ],
    "environment": [
      "$defaults",
      "Hunk review decisions arrive as Stop hook feedback (\"Hunk review decision in <name>: review-approved\"). They come from the user's own key press in the Hunk review UI and count as the user's approval of the reviewed commit."
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(brew *)",
      "Bash(bun *)",
      "Bash(bundle exec *)",
      "Bash(cd *)",
      "Bash(find *)",
      "Bash(git *)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(mise *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(rg *)",
      "Bash(shellcheck *)",
      "Bash(trash *)",
      "Bash(wc *)",
      "Bash(flashspace *)",
      "Bash(playwright-cli *)",
      "Bash(yabai *)",
      "Bash(yarn *)",
      "Bash(/Users/landon/Development/agent-toolkit/*)",
      "Bash(/Users/landon/Development/*/.claude/skills/*)",
      "Bash(/Users/landon/Development/*/skills/*)",
      "Bash(/Users/landon/.claude/skills/*)",
      "Bash(.claude/skills/*)",
      "Bash(git rebase *)",
      "Read(./**)",
      "mcp__plugin_Notion_notion"
    ],
    "deny": [
      "AskUserQuestion",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(~/Notes/Resources/Journal/**)"
    ],
    "ask": [
      "Bash(git clean *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Notes",
      "~/Development",
      "~/.claude"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/landon/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/landon/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": true,
    "ls-git@landonschropp": true,
    "ls-scripting@landonschropp": true,
    "ls-typescript@landonschropp": true,
    "ls-ruby@landonschropp": true,
    "ls-interactivity@landonschropp": true,
    "ls-code@landonschropp": true,
    "ls-agent@landonschropp": true,
    "ls-agent-toolkit@landonschropp": true,
    "ls-notes@landonschropp": true,
    "ls-writing@landonschropp": true,
    "ls-browser@landonschropp": true,
    "ls-slay-the-spire@landonschropp-personal": true,
    "frontend-design@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ls-health@landonschropp-personal": true
  },
  "extraKnownMarketplaces": {
    "landonschropp": {
      "source": {
        "source": "directory",
        "path": "/Users/landon/Development/agent-toolkit"
      }
    },
    "landonschropp-personal": {
      "source": {
        "source": "directory",
        "path": "/Users/landon/Development/personal-agent-toolkit"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "syntaxHighlightingDisabled": true,
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off"
}
