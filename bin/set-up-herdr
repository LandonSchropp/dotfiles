#!/usr/bin/env bash

set -euo pipefail

# Installs herdr, its Claude Code integration, and its plugins. Herdr uses its own installer rather
# than Homebrew so it can self-update. Idempotent and safe to run repeatedly.

if ! command -v herdr >/dev/null 2>&1; then
  curl -fsSL https://herdr.dev/install.sh | sh
fi

# The Herdr integration installer reformats Claude's settings, causing a messy diff. Let's create a
# backup to ensure that they're properly managed.
settings="$HOME/.claude/settings.json"
backup="$(mktemp)"
cp "$settings" "$backup"

# Integrations
herdr integration install claude

# Restore the previous settings.
cp "$backup" "$settings"

herdr_project_directory="$HOME/Development/herdr-project"

if [ ! -d "$herdr_project_directory" ]; then
  git clone git@github.com:LandonSchropp/herdr-project.git "$herdr_project_directory"
fi

# `herdr plugin link` doesn't run the plugin's build step, so install its dependencies directly.
(cd "$herdr_project_directory" && bun install --frozen-lockfile)

herdr plugin link "$herdr_project_directory"
npx --yes skills add LandonSchropp/herdr-project --skill herdr-project --global --agent claude-code --yes

herdr_group_directory="$HOME/Development/herdr-group"

if [ ! -d "$herdr_group_directory" ]; then
  git clone git@github.com:LandonSchropp/herdr-group.git "$herdr_group_directory"
fi

(cd "$herdr_group_directory" && bun install --frozen-lockfile)

herdr plugin link "$herdr_group_directory"
npx --yes skills add LandonSchropp/herdr-group --skill herdr-group --global --agent claude-code --yes

herdr_pull_request_status_directory="$HOME/Development/herdr-pull-request-status"

if [ ! -d "$herdr_pull_request_status_directory" ]; then
  git clone git@github.com:LandonSchropp/herdr-pull-request-status.git "$herdr_pull_request_status_directory"
fi

# Installs the plugin's dependencies and the LaunchAgent that checks GitHub once a minute.
"$herdr_pull_request_status_directory/scripts/setup.sh"

herdr plugin link "$herdr_pull_request_status_directory"

# Install the Herdr agent skill so Claude Code can operate Herdr from inside a pane.
npx --yes skills add ogulcancelik/herdr --skill herdr --global --agent claude-code --yes
