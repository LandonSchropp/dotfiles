#!/usr/bin/env bash

set -euo pipefail

# Install Homebrew if it has not already been installed.
if ! command -v brew 1>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Ensure Homebrew is included in the $PATH.
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Update Homebrew and installed packages.
brew update

# Add the third-party taps.
brew tap peonping/tap
brew tap keith/formulae
brew tap asmvik/formulae

# Trust the third-party formulas.
brew trust --formula peonping/tap/peon-ping
brew trust --formula keith/formulae/reminders-cli
brew trust --formula asmvik/formulae/yabai

# Install all of the Homebrew applications.
brew bundle --file="$HOME/.dotfiles/Brewfile"

# Update TL/DR definitions.
tldr --update
