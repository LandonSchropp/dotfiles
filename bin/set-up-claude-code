#!/usr/bin/env bash

set -euo pipefail

# Installs the Claude Code skills and integrations rcup can't set up on its own: my own skills (a
# plugin marketplace in a separate repository), the caveman compression skills (installed from
# GitHub) and peon-ping sound notifications (installed from the Homebrew package defined in the
# Brewfile). Safe to run repeatedly.

# Clone the agent-toolkit repository, which Claude's settings register as a plugin marketplace by
# path.
agent_toolkit_directory="$HOME/Development/agent-toolkit"

if [ ! -d "$agent_toolkit_directory" ]; then
  git clone https://github.com/LandonSchropp/agent-toolkit.git "$agent_toolkit_directory"
fi

# The skill scripts import their dependencies, and node_modules isn't checked in.
(cd "$agent_toolkit_directory" && bun install --frozen-lockfile)

# Install the caveman skills.
npx -y skills add JuliusBrussee/caveman \
  --global \
  --agent claude-code \
  --yes \
  --skill caveman \
  --skill caveman-commit \
  --skill caveman-compress \
  --skill caveman-review

# Set up peon-ping. The package itself is installed by set-up-homebrew via the Brewfile; this wires
# up the sound packs and registers the Claude Code hooks.
if ! command -v peon-ping-setup >/dev/null 2>&1; then
  echo "Error: peon-ping-setup was not found. Run set-up-homebrew first to install peon-ping." >&2
  exit 1
fi

peon-ping-setup
