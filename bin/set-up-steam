#!/usr/bin/env bash

set -euo pipefail

# Patches Steam's app wrappers in ~/Applications to start Steam silently in the background.

shopt -s nullglob

if [[ -d "$HOME/Applications/Slay the Spire.app" ]]; then
  cat >"$HOME/Applications/Slay the Spire.app/Contents/MacOS/run.sh" <<'BASH'
#!/bin/bash

pgrep -xq steam_osx || open -g -a Steam --args -silent
open "$HOME/Library/Application Support/Steam/steamapps/common/SlayTheSpire/ModTheSpire.app"
BASH

  echo "Patched Slay the Spire"
fi

for wrapper in "$HOME"/Applications/*.app/Contents/MacOS/run.sh; do
  application_id="$(sed -n -E 's|^open steam://run/([0-9]+)$|\1|p' "$wrapper")"
  [[ -n "$application_id" ]] || continue

  cat >"$wrapper" <<BASH
#!/bin/bash
# autogenerated file - do not edit

if pgrep -xq steam_osx; then
  open steam://run/$application_id
else
  open -g -a Steam --args -silent -applaunch $application_id
fi
BASH

  echo "Patched $(basename "${wrapper%%.app/*}")"
done
